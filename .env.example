# ===== Required for production (Vercel) =====
SECRET_KEY=generate-a-long-random-string

# Neon PostgreSQL (Dashboard → Connection string → URI)
# Example: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Cloudinary (Dashboard → API Keys)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pathari-11-fc

# Admin login
ADMIN_EMAIL=admin@patharifc.com
ADMIN_PASSWORD=change-this-password

# Optional
SEED_ON_START=true
DEMO_MODE=false
SESSION_COOKIE_SECURE=true
